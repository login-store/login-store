rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ADMIN_EMAIL@gmail.com';
    }

    function validOrder(d) {
      return d.keys().hasOnly(['orderNo','createdAt','name','phone','address','note','items','total','status','uid'])
        && d.keys().hasAll(['orderNo','createdAt','name','phone','address','items','total','status'])
        && d.orderNo is string && d.orderNo.size() <= 40
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 100
        && d.phone is string && d.phone.size() >= 8 && d.phone.size() <= 20
        && d.address is string && d.address.size() >= 5 && d.address.size() <= 400
        && (!('note' in d) || (d.note is string && d.note.size() <= 400))
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 50
        && d.total is number && d.total >= 0 && d.total < 1000000
        && d.status == 'new'
        && d.createdAt is timestamp
        // الطلب يُربط بحساب العميل فقط لو العميل مسجّل دخوله فعلًا
        && (!('uid' in d) || (request.auth != null && d.uid == request.auth.uid));
    }

    match /orders/{id} {
      // أي زائر (أو عميل مسجّل) يستطيع إنشاء طلب صحيح فقط
      allow create: if validOrder(request.resource.data);
      // المالك يقرأ كل الطلبات، والعميل يقرأ طلباته هو فقط
      allow read: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      // التعديل والحذف للمالك فقط
      allow update, delete: if isAdmin();
    }

    // بيانات العميل (الاسم والهاتف والعنوان): كل عميل يصل لبياناته فقط
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','phone','address'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.address is string && request.resource.data.address.size() <= 400;
    }
  }
}
